<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude health conversation database, models, and history preferences from cloud backup -->
        <exclude domain="database" path="voice_doctor_database" />
        <exclude domain="database" path="voice_doctor_database-shm" />
        <exclude domain="database" path="voice_doctor_database-wal" />
        <exclude domain="file" path="models" />
        <exclude domain="sharedpref" path="voice_doctor_history_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="voice_doctor_database" />
        <exclude domain="database" path="voice_doctor_database-shm" />
        <exclude domain="database" path="voice_doctor_database-wal" />
        <exclude domain="file" path="models" />
        <exclude domain="sharedpref" path="voice_doctor_history_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
